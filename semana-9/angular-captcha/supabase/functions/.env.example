# Secret key de reCAPTCHA v2 (NO es la site key).
# Se obtiene en https://www.google.com/recaptcha/admin al registrar el sitio.
RECAPTCHA_SECRET=

# Hostnames del frontend permitidos, separados por coma.
# Si se deja vacio no se valida el hostname. En produccion NO incluir localhost.
CAPTCHA_HOSTNAMES=localhost,127.0.0.1

# Secret key de Cloudflare Turnstile (NO es la site key).
# Se obtiene en el dashboard de Cloudflare > Turnstile, al registrar el widget.
TURNSTILE_SECRET=

# Hostnames del frontend permitidos, separados por coma.
# Si se deja vacio no se valida el hostname. En produccion NO incluir localhost.
TURNSTILE_HOSTNAMES=localhost
